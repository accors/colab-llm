#!/usr/bin/env bash
# colab-llm: run a GGUF model with llama.cpp on a Colab GPU, driven from a
# Linux/macOS box with the Colab CLI, and reach it at http://127.0.0.1:PORT/v1
# through `ssh -L` (no public tunnel).
#
#   colab-llm init               one-time: config, API key, ssh config, checks
#   colab-llm prep --gpu T4 [--rebuild] [--models]
#                                build llama-server on a T4 and cache it on Drive;
#                                also copies the model to Drive if SOURCE=drive or --models
#   colab-llm up [--keep]        GPU session: load model, start server + tunnel
#   colab-llm status             session, watchdog, local endpoint, CU balance
#   colab-llm logs [server|watchdog|supervisor] [-f]
#   colab-llm restart            reload llama-server (after editing config.env)
#   colab-llm down               stop everything and release the GPU
#   colab-llm chat [PROMPT]      quick test with chat.py
#   colab-llm ssh [CMD...]       shell (or one command) on the GPU session
#   colab-llm usage              compute-unit balance (colab usage)
set -euo pipefail

REPO_DIR="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/.." && pwd)"
CONFIG="${COLAB_LLM_CONFIG:-$REPO_DIR/config.env}"
CONF_DIR="${XDG_CONFIG_HOME:-$HOME/.config}/colab-llm"
STATE_DIR="${XDG_STATE_HOME:-$HOME/.local/state}/colab-llm"
KEY_FILE="$CONF_DIR/api_key"
CLIENT_ENV="$CONF_DIR/client.env"
SSH_CFG="$CONF_DIR/ssh_config"
SUP_PID="$STATE_DIR/supervisor.pid"
SUP_LOG="$STATE_DIR/supervisor.log"
WD_LOG="$STATE_DIR/watchdog.log"
REMOTE_APP=/content/colab-llm

die() { echo "colab-llm: $*" >&2; exit 1; }
note() { echo "[colab-llm $(date +%H:%M:%S)] $*"; }

load_config() {
  [[ -f "$CONFIG" ]] || die "no config at $CONFIG (run: colab-llm init)"
  # shellcheck disable=SC1090
  source "$CONFIG"
  : "${SESSION:=llm}" "${PREP_SESSION:=llm-prep}" "${GPU:=A100}" "${HIGH_MEM:=1}"
  : "${HF_REPO:?HF_REPO must be set in $CONFIG}" "${QUANT:=IQ3_S}" "${SOURCE:=drive}"
  : "${DRIVE_MODELS:=/content/drive/MyDrive/models}" "${MMPROJ:=0}" "${MTP_REPO:=}" "${MTP_FILE:=}"
  : "${LLAMA_CPP_REF:=master}" "${CUDA_ARCHS:=80}" "${MIN_VRAM_GIB:=75}"
  : "${REMOTE_PORT:=8000}" "${LOCAL_PORT:=8080}" "${CTX:=262144}" "${PARALLEL:=1}"
  : "${ALIAS:=qwen3.8-flash-next}" "${EXTRA_ARGS:=}" "${LOAD_TIMEOUT:=1800}"
  : "${IDLE_MINUTES:=15}" "${MAX_HOURS:=8}" "${POLL:=30}" "${NOTIFY_CMD:=}" "${XET_HIGH_PERF:=1}"
  COLAB="$(command -v colab || true)"
  [[ -n "$COLAB" ]] || die "colab CLI not found (uv tool install google-colab-cli)"
  SSH_HOST="colab-llm-$SESSION"
  mkdir -p "$STATE_DIR"
}

# Variables forwarded to the remote scripts with `colab exec --env`.
# The API key is NOT among them: `colab exec` records the code it sends (env
# prelude included) in ~/.config/colab-cli/history, so the key goes over ssh.
REMOTE_VARS=(HF_REPO QUANT SOURCE DRIVE_MODELS MMPROJ MTP_REPO MTP_FILE BUILD FORCE_BUILD SYNC_MODELS
  LLAMA_CPP_REF CUDA_ARCHS MIN_VRAM_GIB REMOTE_PORT CTX PARALLEL ALIAS EXTRA_ARGS
  LOAD_TIMEOUT IDLE_MINUTES MAX_HOURS POLL XET_HIGH_PERF)

# session_alive NAME [ACCELERATOR]: the session exists (and has that accelerator).
session_alive() {
  local out
  out="$("$COLAB" status -s "$1" 2>&1)" || return 1
  [[ -n "$out" && "$out" != *"not found"* && "$out" != *"No active sessions"* ]] || return 1
  if [[ -n "${2:-}" ]]; then
    grep -qi -- "$2" <<<"$out" || return 1
  fi
}

# rssh ARGS...: ssh to the GPU session, but only if it exists. `colab ssh
# --proxy-mode -s NAME` silently creates a (CPU) session when NAME is missing,
# so never let ssh run against a session that is gone.
rssh() {
  session_alive "$SESSION" || die "session '$SESSION' is not running"
  ssh -F "$SSH_CFG" "$@"
}

write_ssh_config() {
  mkdir -p "$CONF_DIR"
  local ident=""
  for k in "$HOME/.ssh/id_ed25519" "$HOME/.ssh/id_ecdsa"; do
    [[ -f "$k" ]] && { ident="$k"; break; }
  done
  [[ -n "$ident" ]] || die "no ~/.ssh/id_ed25519 (Colab rejects RSA keys): ssh-keygen -t ed25519"
  cat >"$SSH_CFG" <<EOF
# generated by colab-llm; regenerated on every run
Host $SSH_HOST
  ProxyCommand $COLAB ssh --proxy-mode -s $SESSION -i $ident
  User root
  IdentityFile $ident
  IdentitiesOnly yes
  StrictHostKeyChecking no
  UserKnownHostsFile /dev/null
  LogLevel ERROR
  ServerAliveInterval 30
  ServerAliveCountMax 3
  ConnectTimeout 60
  # one shared connection: Colab caps concurrent SSH connections per runtime
  ControlMaster auto
  ControlPath $STATE_DIR/cm-%C
  ControlPersist no
EOF
}

# cexec SESSION SCRIPT IDLE_TIMEOUT LOGFILE: run remote/common.py + SCRIPT via
# `colab exec`, stream output to the terminal and LOGFILE, succeed only if the
# script printed `COLAB_LLM_RESULT ok`.
cexec() {
  local session="$1" script="$2" timeout="$3" logfile="$4" payload args=() v
  payload="$STATE_DIR/payload-$(basename "$script")"
  cat "$REPO_DIR/remote/common.py" "$REPO_DIR/remote/$script" >"$payload"
  for v in "${REMOTE_VARS[@]}"; do
    args+=(--env "$v=${!v:-}")
  done
  args+=(--env "COLAB_LLM_TAG=${script%.py}")
  "$COLAB" exec -s "$session" -f "$payload" --timeout "$timeout" "${args[@]}" 2>&1 | tee -a "$logfile"
  grep -q '^COLAB_LLM_RESULT ok' <(tail -n 5 "$logfile")
}

kexec() { # small inline snippet, e.g. mkdir; keeps secrets out of it
  printf '%s\n' "$2" | "$COLAB" exec -s "$1" --timeout 120 >/dev/null
}

local_healthy() {
  curl -fsS -m 5 "http://127.0.0.1:$LOCAL_PORT/health" >/dev/null 2>&1
}

supervisor_running() {
  [[ -f "$SUP_PID" ]] && kill -0 "$(cat "$SUP_PID")" 2>/dev/null
}

# ---------------------------------------------------------------- commands

cmd_init() {
  mkdir -p "$CONF_DIR" "$STATE_DIR"
  chmod 700 "$CONF_DIR"
  if [[ ! -f "$CONFIG" ]]; then
    cp "$REPO_DIR/config.env.example" "$CONFIG"
    echo "created $CONFIG (edit it, then rerun init)"
  fi
  load_config
  if [[ ! -s "$KEY_FILE" ]]; then
    (umask 077; python3 -c 'import secrets; print(secrets.token_urlsafe(32))' >"$KEY_FILE")
    echo "created API key: $KEY_FILE"
  fi
  (umask 077; printf 'COLAB_LLM_URL=http://127.0.0.1:%s/v1\nCOLAB_LLM_KEY=%s\nCOLAB_LLM_MODEL=%s\n' \
    "$LOCAL_PORT" "$(cat "$KEY_FILE")" "$ALIAS" >"$CLIENT_ENV")
  echo "client settings: $CLIENT_ENV"
  write_ssh_config
  echo "ssh config: $SSH_CFG"
  command -v curl >/dev/null || die "curl is required"
  echo "checking Colab auth..."
  "$COLAB" usage || die "colab usage failed: authenticate the CLI first (see README)"
}

cmd_prep() {
  load_config
  local rebuild=0 gpu="" sync=0
  [[ "$SOURCE" == drive ]] && sync=1
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --rebuild) rebuild=1; shift ;;
      --gpu) gpu="${2:?--gpu needs a value, e.g. T4}"; shift 2 ;;
      --models) sync=1; shift ;; # also back the model up to Drive with SOURCE=hf
      *) die "prep: unknown option $1 (--gpu T4, --rebuild, --models)" ;;
    esac
  done
  if [[ "$sync" == 0 && -z "$gpu" ]]; then
    die "SOURCE=hf: nothing to do on a CPU session (no nvcc). Use: colab-llm prep --gpu T4"
  fi
  local logfile="$STATE_DIR/prep.log"
  : >"$logfile"
  if session_alive "$PREP_SESSION"; then
    note "reusing session $PREP_SESSION"
  elif [[ -n "$gpu" ]]; then
    # GPU images ship nvcc; the CPU image does not. A T4 (~1.2 CU/h) can
    # cross-compile for CUDA_ARCHS (sm80 for A100) far cheaper than the A100.
    note "creating $gpu session $PREP_SESSION (high-mem) to build llama-server"
    "$COLAB" new -s "$PREP_SESSION" --gpu "$gpu" --high-mem
  else
    note "creating CPU session $PREP_SESSION (high-mem)"
    "$COLAB" new -s "$PREP_SESSION" --high-mem
  fi
  trap 'note "stopping $PREP_SESSION"; "$COLAB" stop -s "$PREP_SESSION" || true' EXIT
  note "mounting Drive (approve in the browser if asked)"
  "$COLAB" drivemount -s "$PREP_SESSION"
  local build="${BUILD:-auto}"
  [[ -n "$gpu" ]] && build=yes
  BUILD="$build" FORCE_BUILD="$rebuild" SYNC_MODELS="$sync" \
    cexec "$PREP_SESSION" prep.py 900 "$logfile" || die "prep failed (log: $logfile)"
  note "prep done"
}

start_supervisor() {
  note "starting supervisor (log: $SUP_LOG)"
  if command -v setsid >/dev/null; then
    setsid nohup "$REPO_DIR/bin/colab-llm" _supervise >>"$SUP_LOG" 2>&1 </dev/null &
  else
    nohup "$REPO_DIR/bin/colab-llm" _supervise >>"$SUP_LOG" 2>&1 </dev/null &
  fi
  for _ in $(seq 1 60); do
    if local_healthy; then
      note "endpoint up: http://127.0.0.1:$LOCAL_PORT/v1 (model: $ALIAS)"
      return 0
    fi
    sleep 2
  done
  die "server is up on Colab but the local port does not answer; see: colab-llm logs supervisor"
}

cmd_up() {
  load_config
  local keep=0
  [[ "${1:-}" == "--keep" ]] && keep=1
  supervisor_running && die "already running (colab-llm status / colab-llm down)"
  [[ -s "$KEY_FILE" ]] || die "no API key, run: colab-llm init"
  write_ssh_config
  local logfile="$STATE_DIR/serve.log"
  : >"$logfile"

  if session_alive "$SESSION"; then
    session_alive "$SESSION" "$GPU" || die "session '$SESSION' exists but is not a $GPU session (colab stop -s $SESSION)"
    note "session $SESSION already exists: reloading the server on it"
    cmd_restart
    return
  fi
  local flags=(--gpu "$GPU")
  [[ "$HIGH_MEM" == 1 ]] && flags+=(--high-mem)
  note "creating $GPU session $SESSION (${flags[*]})"
  "$COLAB" new -s "$SESSION" "${flags[@]}"
  UP_OK=0
  if [[ "$keep" == 0 ]]; then
    trap '[[ "$UP_OK" == 1 ]] || { note "setup failed: stopping $SESSION so it does not keep billing (use --keep to debug)"; "$COLAB" stop -s "$SESSION" || true; }' EXIT
  fi

  note "checking ssh and sending the API key"
  kexec "$SESSION" "import os; os.makedirs('$REMOTE_APP', mode=0o700, exist_ok=True)"
  rssh "$SSH_HOST" "umask 077; cat > $REMOTE_APP/api_key" <"$KEY_FILE"

  if [[ "$SOURCE" == drive || "$DRIVE_MODELS" == /content/drive/* ]]; then
    note "mounting Drive (approve in the browser if asked)"
    "$COLAB" drivemount -s "$SESSION"
  fi
  cexec "$SESSION" serve.py 900 "$logfile" || die "serve failed (log: $logfile)"
  start_supervisor
  UP_OK=1
  "$COLAB" usage || true
}

cmd_down() {
  load_config
  if supervisor_running; then
    note "stopping supervisor"
    kill "$(cat "$SUP_PID")" 2>/dev/null || true
    sleep 2
  fi
  rm -f "$SUP_PID"
  if session_alive "$SESSION"; then
    note "stopping session $SESSION"
    "$COLAB" stop -s "$SESSION"
  else
    note "session $SESSION is not running"
  fi
  "$COLAB" usage || true
}

remote_state() { # prints watchdog.json or nothing
  ssh -F "$SSH_CFG" -o ConnectTimeout=30 "$SSH_HOST" "cat $REMOTE_APP/state/watchdog.json 2>/dev/null" 2>/dev/null || true
}

cmd_restart() {
  load_config
  session_alive "$SESSION" "$GPU" || die "session '$SESSION' is not running (use: colab-llm up)"
  write_ssh_config
  local st
  st="$(remote_state)"
  if [[ -n "$st" && "$st" != *'"exited": true'* ]]; then
    note "asking the watchdog to step aside"
    rssh "$SSH_HOST" "touch $REMOTE_APP/state/STOP"
    for _ in $(seq 1 30); do
      sleep 3
      st="$(remote_state)"
      [[ "$st" == *'"exited": true'* ]] && break
    done
    [[ "$st" == *'"exited": true'* ]] || die "watchdog did not stop; check: colab-llm logs watchdog"
  fi
  if supervisor_running; then
    kill "$(cat "$SUP_PID")" 2>/dev/null || true
    sleep 2
  fi
  rm -f "$SUP_PID"
  rssh "$SSH_HOST" "umask 077; cat > $REMOTE_APP/api_key" <"$KEY_FILE"
  if [[ "$SOURCE" == drive || "$DRIVE_MODELS" == /content/drive/* ]]; then
    "$COLAB" drivemount -s "$SESSION" # no-op if still mounted; serve unmounts after a build
  fi
  local logfile="$STATE_DIR/serve.log"
  : >"$logfile"
  cexec "$SESSION" serve.py 900 "$logfile" || die "serve failed (log: $logfile); the session is still up: colab-llm down"
  start_supervisor
}

cmd_status() {
  load_config
  "$COLAB" status -s "$SESSION" || true
  if supervisor_running; then
    echo "supervisor: running (pid $(cat "$SUP_PID"))"
  else
    echo "supervisor: not running"
  fi
  if local_healthy; then
    echo "endpoint: http://127.0.0.1:$LOCAL_PORT/v1 healthy (model: $ALIAS)"
  else
    echo "endpoint: http://127.0.0.1:$LOCAL_PORT/v1 not answering"
  fi
  if session_alive "$SESSION"; then
    write_ssh_config
    local st
    st="$(remote_state)"
    [[ -n "$st" ]] && python3 - "$st" <<'EOF'
import json, sys, time
s = json.loads(sys.argv[1])
print(f"watchdog: {'exited (' + s.get('reason', '?') + ')' if s.get('exited') else 'running'}"
      f" | idle {s.get('idle_for', 0) / 60:.1f} min | session age {s.get('age', 0) / 3600:.2f} h"
      f" | heartbeat {time.time() - s.get('heartbeat', 0):.0f}s ago")
t = s.get("tokens") or {}
if t:
    print(f"tokens: prompt {t.get('prompt_tokens_total', 0):.0f}, generated {t.get('tokens_predicted_total', 0):.0f}")
EOF
  fi
  "$COLAB" usage || true
}

cmd_logs() {
  load_config
  local which="${1:-server}" follow=""
  [[ "${2:-}" == "-f" || "${1:-}" == "-f" ]] && follow="-f"
  [[ "$which" == "-f" ]] && which=server
  case "$which" in
    server) write_ssh_config; rssh "$SSH_HOST" "tail -n 100 $follow $REMOTE_APP/logs/llama-server.log" ;;
    watchdog) tail -n 100 $follow "$WD_LOG" ;;
    supervisor) tail -n 100 $follow "$SUP_LOG" ;;
    serve | prep) tail -n 100 $follow "$STATE_DIR/$which.log" ;;
    *) die "logs: server | watchdog | supervisor | serve | prep" ;;
  esac
}

cmd_ssh() {
  load_config
  write_ssh_config
  if [[ $# -eq 0 ]]; then
    rssh -t "$SSH_HOST" "cd /content && exec bash -l"
  else
    rssh "$SSH_HOST" "$@"
  fi
}

# ------------------------------------------------------------- supervisor
# Runs in the background after `up`. Keeps the ssh tunnel up, runs the
# watchdog in the Colab kernel, and calls `colab stop` when the watchdog
# reports idle / max / server_dead.

sup_log() { echo "[$(date '+%F %T')] $*"; }

notify() {
  [[ -n "$NOTIFY_CMD" ]] || return 0
  COLAB_LLM_EVENT="$1" bash -c "$NOTIFY_CMD" >/dev/null 2>&1 || true
}

cmd__supervise() {
  load_config
  write_ssh_config
  echo $$ >"$SUP_PID"
  local wd_pid="" tunnel_pid=""

  start_watchdog() {
    sup_log "launching watchdog in the kernel"
    cexec "$SESSION" watchdog.py 0 "$WD_LOG" >/dev/null 2>&1 &
    wd_pid=$!
  }

  tunnel_loop() {
    while session_alive "$SESSION" "$GPU"; do
      sup_log "tunnel: 127.0.0.1:$LOCAL_PORT -> colab 127.0.0.1:$REMOTE_PORT"
      ssh -F "$SSH_CFG" -M -N -o ExitOnForwardFailure=yes \
        -L "127.0.0.1:$LOCAL_PORT:127.0.0.1:$REMOTE_PORT" "$SSH_HOST" || true
      sup_log "tunnel exited, retrying in 5s"
      sleep 5
    done
    sup_log "tunnel: session gone, not reconnecting"
  }

  cleanup() {
    [[ -n "$tunnel_pid" ]] && kill "$tunnel_pid" 2>/dev/null || true
    [[ -n "$wd_pid" ]] && kill "$wd_pid" 2>/dev/null || true
    pkill -f -- "-L 127.0.0.1:$LOCAL_PORT:127.0.0.1:$REMOTE_PORT $SSH_HOST" 2>/dev/null || true
    pkill -f -- "exec -s $SESSION -f $STATE_DIR/payload-watchdog.py" 2>/dev/null || true
    ssh -F "$SSH_CFG" -O exit "$SSH_HOST" >/dev/null 2>&1 || true
    rm -f "$SUP_PID"
  }

  finish_session() { # reason
    sup_log "watchdog reported '$1': stopping session $SESSION"
    cleanup
    "$COLAB" stop -s "$SESSION" || true
    notify "$1"
    sup_log "stopped"
    exit 0
  }

  trap 'sup_log "supervisor: terminated"; cleanup; exit 0' TERM INT
  sup_log "supervisor up (session $SESSION, idle ${IDLE_MINUTES} min, max ${MAX_HOURS} h)"
  start_watchdog
  tunnel_loop &
  tunnel_pid=$!

  local st reason hb_age
  while true; do
    sleep "${SUP_INTERVAL:-60}"
    if ! session_alive "$SESSION"; then
      sup_log "session $SESSION is gone (reclaimed or stopped elsewhere)"
      cleanup
      notify gone
      exit 0
    fi
    if ! session_alive "$SESSION" "$GPU"; then
      # a CPU session with our name: created by a stray ProxyCommand reconnect
      sup_log "session $SESSION is no longer a $GPU session: stopping it"
      finish_session wrong_session
    fi
    st="$(remote_state)"
    [[ -n "$st" ]] || { sup_log "could not read watchdog state (ssh down?)"; continue; }
    read -r reason hb_age < <(python3 -c '
import json, sys, time
s = json.loads(sys.argv[1])
print(s.get("reason", "-") if s.get("exited") else "-", int(time.time() - s.get("heartbeat", 0)))
' "$st" 2>/dev/null || echo "- 0")
    # "stop" is left over from `colab-llm restart` until the relaunched
    # watchdog writes its first state; the heartbeat check below covers it.
    case "$reason" in
      idle | max | server_dead) finish_session "$reason" ;;
    esac
    if ((hb_age > 180)) && ! kill -0 "$wd_pid" 2>/dev/null; then
      sup_log "watchdog heartbeat is ${hb_age}s old and its exec is gone: relaunching"
      start_watchdog
    fi
  done
}

# ------------------------------------------------------------------- main

main() {
  local cmd="${1:-help}"
  shift || true
  case "$cmd" in
    init | prep | up | down | restart | status | logs | ssh | _supervise) "cmd_$cmd" "$@" ;;
    chat) exec python3 "$REPO_DIR/chat.py" "$@" ;;
    usage) load_config; "$COLAB" usage ;;
    help | -h | --help) sed -n '2,16p' "${BASH_SOURCE[0]}" | sed 's/^# \{0,1\}//' ;;
    *) die "unknown command '$cmd' (colab-llm help)" ;;
  esac
}

main "$@"
