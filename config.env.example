# colab-llm config. Copy to config.env (`colab-llm init` does it) and edit.
# This file is sourced by bash; values with spaces need quotes.

# ---- Colab sessions
SESSION=llm             # GPU session name used by up/down/restart
PREP_SESSION=llm-prep   # CPU session used by prep
GPU=A100
HIGH_MEM=1              # A100 + --high-mem is how the 80 GB card is requested
MIN_VRAM_GIB=75         # serve refuses smaller GPUs (a 40 GB A100 cannot hold this model)

# ---- Model
# Official weights, ISTA-DASLab GSQ-RCO quant (best-documented quality):
HF_REPO=ISTA-DASLab/Qwen3.8-Flash-Next-GSQ-RCO-GGUF
# Abliterated (refusals removed) by tensor transplant into the same quant; loads in stock
# llama.cpp, but its quality and tool calling are untested. Same 28.8 GB n-gram shard size.
# HF_REPO=SC117/Qwen3.8-Flash-Next-GSQ-RCO-abliterated-GGUF
QUANT=IQ3_S             # IQ3_S (54.8 GB in VRAM) | IQ3_XXS (47.0 GB) | IQ2_XS | Q2_0
MMPROJ=0                # 1 = also fetch the vision projector (0.9 GB) and load it
# Optional MTP draft head for speculative decoding (only SC117 publishes a llama.cpp one):
MTP_REPO=
MTP_FILE=               # e.g. MTP_REPO=SC117/Qwen3.8-Flash-Next-GSQ-RCO-abliterated-GGUF MTP_FILE=mtp-Qwen3.8-Flash-Next-Q4_0.gguf

XET_HIGH_PERF=1         # hf_xet high-performance mode (more parallel connections) for HF downloads

# Where serve gets the model: drive (copy from Drive, filled by `prep`) or hf (download each time)
SOURCE=drive
DRIVE_MODELS=/content/drive/MyDrive/models

# ---- llama.cpp
LLAMA_CPP_REF=master    # branch, tag or full commit sha; builds are cached on Drive
CUDA_ARCHS=80           # 80 = A100 (add ,90 for H100 / ,120 for G4 at the cost of build time)
CTX=262144              # native context; KV cache is ~24 KiB/token here (~6 GiB at 256K)
PARALLEL=1              # server slots; context is split between them
ALIAS=qwen3.8-flash-next
EXTRA_ARGS=""           # appended to llama-server, e.g. "--temp 0.6 --top-p 0.95"
LOAD_TIMEOUT=1800       # seconds to wait for /health

# ---- Ports (the server listens on 127.0.0.1 on Colab; reached via ssh -L)
REMOTE_PORT=8000
LOCAL_PORT=8080

# ---- Cost control
IDLE_MINUTES=15         # stop the GPU session after this long without tokens
MAX_HOURS=8             # hard cap per session (0 = none)
POLL=30                 # watchdog poll interval, seconds
# Shell command run when the supervisor stops the session; $COLAB_LLM_EVENT is
# idle | max | server_dead | gone | wrong_session. Example (ntfy):
# NOTIFY_CMD='curl -s -d "colab-llm: $COLAB_LLM_EVENT" ntfy.sh/your-topic'
NOTIFY_CMD=
